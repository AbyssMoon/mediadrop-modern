# Keep the Compose project name stable between upgrades. It determines the MariaDB
# named-volume name (default: mediadrop-modern_mediadrop_db).
COMPOSE_PROJECT_NAME=mediadrop-modern

APP_NAME=MediaDrop
LOCALE=en
# 127.0.0.1 is for a reverse proxy on the same host. If the corporate nginx is on
# another host, bind to this server's private IP reachable by nginx (or 0.0.0.0 + firewall).
BIND_ADDR=127.0.0.1
HTTP_PORT=8080

DB_NAME=mediadrop
DB_USER=mediadrop
DB_PASSWORD=replace-with-long-random-password
DB_ROOT_PASSWORD=replace-with-another-long-random-password
SECRET_KEY=replace-with-a-long-random-session-secret

# Host directories mounted into the app container by compose.yml.
# MODERN_DATA_ROOT is writable and contains new uploads, previews, SQLite and logs.
MODERN_DATA_ROOT=/opt/mediadrop-modern-data
# LEGACY_DATA_ROOT points at the copied old MediaDrop data tree and is mounted read-only.
LEGACY_DATA_ROOT=/opt/mediadrop_data

# Usually leave this as-is in Docker. The file is physically stored at:
# ${MODERN_DATA_ROOT}/modern/mediadrop-modern.db on the host.
MODERN_DATABASE_URL=sqlite:////data/modern/mediadrop-modern.db

COOKIE_SECURE=true
PUBLIC_UPLOADS=false
UPLOADS_REQUIRE_REVIEW=true
# Use "app" when nginx is only an external reverse proxy and does not share the media filesystem.
# Use "nginx" only when nginx can resolve the configured X-Accel-Redirect path to the same files.
MEDIA_SERVE_MODE=app
MAX_UPLOAD_MB=2047
MAX_THUMBNAIL_MB=20

# Container path. With the default compose mount this becomes:
# /opt/mediadrop-modern-data/logs/audit.log on the host.
AUDIT_LOG_PATH=/data/logs/audit.log
