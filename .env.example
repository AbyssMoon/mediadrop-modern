APP_NAME=MediaDrop
LOCALE=en
BIND_ADDR=127.0.0.1
HTTP_PORT=8080

DB_NAME=mediadrop
DB_USER=mediadrop
DB_PASSWORD=replace-with-long-random-password
DB_ROOT_PASSWORD=replace-with-another-long-random-password
SECRET_KEY=replace-with-a-long-random-session-secret
# Usually leave this as-is in Docker; it stores only modern auth/LDAP settings.
MODERN_DATABASE_URL=sqlite:////data/modern/mediadrop-modern.db

COOKIE_SECURE=true
PUBLIC_UPLOADS=false
UPLOADS_REQUIRE_REVIEW=true
MEDIA_SERVE_MODE=app
MAX_UPLOAD_MB=2047

# Root of the copied legacy MediaDrop data directory on the Docker host.
LEGACY_DATA_ROOT=/opt/mediadrop_data
MAX_THUMBNAIL_MB=20
